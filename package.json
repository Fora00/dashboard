{
  "name": "dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "oxlint && npm run --silent format:check && tsc -b && vitest run",
    "roadmap": "node scripts/roadmap-open.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "preview": "vite preview",
    "new-project": "node scripts/new-project.mjs",
    "events:crawl": "node --disable-warning=ExperimentalWarning scripts/events/crawl.ts",
    "life:link": "node --disable-warning=ExperimentalWarning scripts/life-link.ts",
    "life:things-lists": "node --disable-warning=ExperimentalWarning scripts/life-things-lists.ts",
    "life:things-status": "node --disable-warning=ExperimentalWarning scripts/life-things-status.ts",
    "db:types": "node scripts/db-types.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "fake-indexeddb": "^6.2.5",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22"
  }
}
